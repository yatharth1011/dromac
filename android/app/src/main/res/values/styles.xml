<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DromacButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="DromacSectionLabel">
        <item name="android:textColor">@color/fg_dimmer</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
